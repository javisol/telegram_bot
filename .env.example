# Telegram Bot Configuration
# Copy this file to .env and fill in your values

# Telegram Bot Token (from @BotFather)
TOKEN=your_telegram_bot_token_here

# LLM API Configuration
# For internal Docker network, use: http://rtn:11444
# For external services, use: https://llm-api.example.com:11444
LLM_API_URL=http://rtn:11444

# System Prompt for LLM
# Customize the AI's identity and behavior
SYSTEM_PROMPT="You are RatoncIA, an intelligent AI assistant. Provide helpful, accurate, and friendly responses. Answer in the language of the user's query."

# Conversation Context Configuration
# SQLite database path for storing conversation history
# Default: data/llm_conversation.db
LLM_CONVERSATION_DB_PATH=data/llm_conversation.db

# Calendar Configuration
# Set these environment variables for calendar access
CAL_URL=https://calendar.example.com
CAL_USER=calendar_user
CAL_PASS=calendar_password

# Oblique Strategies File Path
# Path to the oblique strategies JSON file
OBLIQUE_STRATEGIES_FILE=/data/repositories/telegram_bot/oblique_strategies/oblique_strategies_2015.json

# Security Recommendations:
# 1. Use HTTPS for external services (LLM_API_URL, CAL_URL)
# 2. Store secrets in a secrets manager for production
# 3. Rotate credentials regularly
# 4. Use strong passwords for all services
# 5. Limit file paths to prevent path traversal attacks
